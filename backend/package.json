{
    "name": "muonglab-api",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "MUONGLAB backend – Express + PostgreSQL (Prisma)",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/server.js",
        "start": "node --env-file-if-exists=.env src/server.js",
        "db:up": "docker compose -f ../docker-compose.yml up -d db",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:reset": "prisma migrate reset",
        "db:studio": "prisma studio",
        "admin:grant": "node --env-file-if-exists=.env scripts/grant-admin.js",
        "test": "node --env-file-if-exists=.env --test \"test/**/*.test.js\""
    },
    "prisma": {
        "seed": "node --env-file-if-exists=.env prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "express": "^4.22.3",
        "express-rate-limit": "^7.5.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.5.0",
        "nodemailer": "^10.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "prisma": "^6.19.3"
    }
}
