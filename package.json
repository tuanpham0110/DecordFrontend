{
    "name": "muonglab",
    "private": true,
    "type": "module",
    "description": "MUONGLAB – frontend (React + Vite) và backend (Express + PostgreSQL)",
    "scripts": {
        "setup": "npm --prefix backend install && npm --prefix frontend install",
        "db:up": "docker compose up -d db",
        "db:migrate": "npm --prefix backend run db:deploy",
        "db:seed": "npm --prefix backend run db:seed",
        "dev:api": "npm --prefix backend run dev",
        "dev:web": "npm --prefix frontend run dev",
        "test": "npm --prefix backend test",
        "build": "npm --prefix frontend run build"
    }
}
