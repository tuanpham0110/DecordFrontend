# Sao chép thành frontend/.env.local nếu cần đổi mặc định (không commit .env.local).

# Địa chỉ API mà trình duyệt gọi. Mặc định "/api" (dev: Vite chuyển tiếp sang backend).
# Khi deploy FE và BE khác domain, đặt URL đầy đủ, ví dụ: https://api.muonglab.vn/api
VITE_API_URL=/api

# (Chỉ dev) backend mà Vite proxy tới
VITE_API_PROXY=http://localhost:4000

# Lưu ý: API key Gemini và dịch vụ chấm phát âm nay cấu hình ở backend/.env – không đặt ở đây.
