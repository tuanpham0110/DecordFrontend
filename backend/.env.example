# Sao chép thành backend/.env rồi điền giá trị. KHÔNG commit file .env.

NODE_ENV=development
PORT=4000
# Khớp với docker-compose.yml ở thư mục gốc
DATABASE_URL="postgresql://muonglab:muonglab@localhost:5434/muonglab?schema=public"
# Địa chỉ frontend được phép gọi API (nhiều địa chỉ cách nhau bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
# true khi chạy sau Nginx / reverse proxy
TRUST_PROXY=false

# Chuỗi ngẫu nhiên ≥ 32 ký tự. Tạo bằng:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES=1d
JWT_REMEMBER_EXPIRES=30d

# % tối thiểu để qua bài
PASS_THRESHOLD=80

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ── Gmail SMTP ──
# Bật xác minh 2 bước cho Gmail → tạo "Mật khẩu ứng dụng" (App Password) tại
# https://myaccount.google.com/apppasswords rồi dán 16 ký tự vào SMTP_PASS.
# Bỏ trống SMTP_* thì mã OTP được in ra console của backend (tiện khi dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MUONGLAB <your-account@gmail.com>"

# ── Trợ lý AI (Google Gemini) ──
# Key tại https://aistudio.google.com/apikey (gói miễn phí). Key chỉ nằm ở backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Model dự phòng, thử lần lượt khi model chính quá tải (503) hoặc bị ngừng (404)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
# số câu hỏi AI tối đa mỗi người/ngày
AI_DAILY_LIMIT=100

# ── Đăng nhập bằng Google ──
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application).
# Thêm địa chỉ frontend (VD http://localhost:5173, https://muonglab.vercel.app) vào "Authorized JavaScript origins".
# Bỏ trống thì nút "Đăng nhập bằng Google" không hiện.
GOOGLE_CLIENT_ID=

# ── Đăng nhập bằng Microsoft ──
# https://entra.microsoft.com → App registrations → New registration
#   Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   Redirect URI: nền tảng "Single-page application", giá trị là địa chỉ frontend (VD https://muonglab.vercel.app, http://localhost:5173)
# Dán "Application (client) ID" vào đây. Bỏ trống thì nút Microsoft không hiện.
MICROSOFT_CLIENT_ID=

# ── Liên hệ / hỗ trợ ──
# Hiện ở trang Hỗ trợ, trang pháp lý; nhận email báo khi người học nhắn (nếu đã cấu hình SMTP)
SUPPORT_EMAIL=phamductuan01102005@gmail.com

# ── Chấm phát âm (Shadowing) ──
# Để trống SPEECH_API_URL: dùng Gemini (GEMINI_API_KEY) chép lại bản ghi rồi so với câu mẫu – điểm ước lượng.
# Có SPEECH_API_URL: gọi dịch vụ chấm phát âm riêng (so với giọng người bản địa).
SPEECH_API_URL=
SPEECH_API_KEY=
